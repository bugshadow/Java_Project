<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventaire.controllers.RapportsController" stylesheets="@../css/global.css">
    
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="10">
            <Label text="INVENTAIRE" styleClass="title" />
            <Label fx:id="labelUtilisateur" text="Utilisateur" styleClass="user-info" wrapText="true" />
            <Separator style="-fx-background-color: transparent;" />
            <Button text="📊 Tableau de bord" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersDashboard" />
            <Button text="📦 Produits" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersProduits" />
            <Button text="🔄 Transactions" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersTransactions" />
            <Button text="📜 Historique" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersHistorique" />
            <Button text="⚠️ Alertes" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersAlertes" />
            <Button text="📈 Rapports" styleClass="menu-button, active" maxWidth="Infinity" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Deconnexion" styleClass="logout-button" maxWidth="Infinity" onAction="#deconnecter" />
        </VBox>
    </left>
    
    <center>
        <VBox styleClass="main-content" spacing="20">
            <Label text="Generation de Rapports" styleClass="page-title" />
            
            <HBox spacing="20">
                <!-- Rapport etat des Stocks -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15">
                    <Label text="etat des Stocks Actuel" styleClass="card-title" />
                    <Label text="Genere un instantane complet de tous les produits en stock, classes par entrepot, avec les valeurs et seuils." wrapText="true" style="-fx-text-fill: #7f8c8d;" />
                    
                    <VBox spacing="5">
                        <Label text="Format" styleClass="form-label" />
                        <HBox spacing="15">
                            <RadioButton fx:id="rbStockPdf" text="PDF (Recommande)" selected="true">
                                <toggleGroup><ToggleGroup fx:id="tgStockFormat" /></toggleGroup>
                            </RadioButton>
                            <RadioButton fx:id="rbStockExcel" text="Excel (.xlsx)" toggleGroup="$tgStockFormat" />
                        </HBox>
                    </VBox>
                    
                    <Region VBox.vgrow="ALWAYS" />
                    <Button fx:id="btnGenererStock" text="Generer Rapport" styleClass="button-primary" maxWidth="Infinity" onAction="#genererRapportStock" />
                </VBox>
                
                <!-- Rapport Mouvements -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15">
                    <Label text="Mouvements et Transactions" styleClass="card-title" />
                    <Label text="Exporte l'historique des entrees, sorties et transferts sur une periode donnee." wrapText="true" style="-fx-text-fill: #7f8c8d;" />
                    
                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Du" styleClass="form-label" />
                            <DatePicker fx:id="dateDebut" maxWidth="Infinity" styleClass="date-picker" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Au" styleClass="form-label" />
                            <DatePicker fx:id="dateFin" maxWidth="Infinity" styleClass="date-picker" />
                        </VBox>
                    </HBox>
                    
                    <VBox spacing="5">
                        <Label text="Format" styleClass="form-label" />
                        <HBox spacing="15">
                            <RadioButton fx:id="rbMouvPdf" text="PDF" selected="true">
                                <toggleGroup><ToggleGroup fx:id="tgMouvFormat" /></toggleGroup>
                            </RadioButton>
                            <RadioButton fx:id="rbMouvExcel" text="Excel (.xlsx)" toggleGroup="$tgMouvFormat" />
                        </HBox>
                    </VBox>
                    
                    <Region VBox.vgrow="ALWAYS" />
                    <Button fx:id="btnGenererMouvements" text="Generer Rapport" styleClass="button-primary" maxWidth="Infinity" onAction="#genererRapportMouvements" />
                </VBox>
            </HBox>
            
            <Label fx:id="labelMessage" styleClass="form-label" wrapText="true" />
            <ProgressIndicator fx:id="progressIndicator" visible="false" />
            
        </VBox>
    </center>
</BorderPane>
