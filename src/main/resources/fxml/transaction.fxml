<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventaire.controllers.TransactionController" stylesheets="@../css/global.css">
    
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="10">
            <Label text="INVENTAIRE" styleClass="title" />
            <Label fx:id="labelUtilisateur" text="Utilisateur" styleClass="user-info" wrapText="true" />
            <Separator style="-fx-background-color: transparent;" />
            <Button text=" Tableau de bord" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersDashboard" />
            <Button text=" Produits" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersProduits" />
            <Button text=" Transactions" styleClass="menu-button, active" maxWidth="Infinity" />
            <Button text=" Historique" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersHistorique" />
            <Button text=" Alertes" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersAlertes" />
            <Button text=" Rapports" styleClass="menu-button" maxWidth="Infinity" onAction="#allerVersRapports" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Deconnexion" styleClass="logout-button" maxWidth="Infinity" onAction="#deconnecter" />
        </VBox>
    </left>
    
    <center>
        <VBox styleClass="main-content" spacing="20">
            <Label text="Saisie d'une Transaction" styleClass="page-title" />
            
            <HBox spacing="20">
                <!-- Formulaire de saisie -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15">
                    <Label text="Nouvelle Operation" styleClass="card-title" />
                    
                    <HBox spacing="15">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Type d'operation *" styleClass="form-label" />
                            <ComboBox fx:id="comboType" promptText="Selectionner..." maxWidth="Infinity" styleClass="combo-box" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Produit *" styleClass="form-label" />
                            <ComboBox fx:id="comboProduit" promptText="Selectionner..." maxWidth="Infinity" styleClass="combo-box" />
                        </VBox>
                    </HBox>
                    
                    <HBox spacing="15">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Quantite *" styleClass="form-label" />
                            <TextField fx:id="champQuantite" promptText="0" styleClass="text-field" />
                        </VBox>
                    </HBox>
                    
                    <!-- Entrepots dynamiques selon le type -->
                    <HBox spacing="15" fx:id="boxEntrepots">
                        <VBox spacing="5" HBox.hgrow="ALWAYS" fx:id="boxEntrepotSource">
                            <Label text="Entrepot Source *" styleClass="form-label" />
                            <ComboBox fx:id="comboEntrepotSource" promptText="Selectionner..." maxWidth="Infinity" styleClass="combo-box" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS" fx:id="boxEntrepotDest">
                            <Label text="Entrepot Destination *" styleClass="form-label" />
                            <ComboBox fx:id="comboEntrepotDest" promptText="Selectionner..." maxWidth="Infinity" styleClass="combo-box" />
                        </VBox>
                    </HBox>

                    <!-- Metadonnees dynamiques -->
                    <VBox spacing="5" fx:id="boxMetadata">
                        <Label fx:id="labelTiers" text="Tiers (Fournisseur/Client)" styleClass="form-label" />
                        <TextField fx:id="champTiers" promptText="Nom..." styleClass="text-field" />
                        <Label text="Reference document (BL)" styleClass="form-label" />
                        <TextField fx:id="champDocument" promptText="Numero BL..." styleClass="text-field" />
                    </VBox>
                    
                    <Label fx:id="labelErreur" styleClass="error-label" wrapText="true" />
                    
                    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 20 0 0 0;">
                        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="24" prefHeight="24" />
                        <Button text="Effacer" styleClass="button-secondary" onAction="#effacerFormulaire" />
                        <Button fx:id="btnValider" text="Valider &amp; Enregistrer sur Blockchain" styleClass="button-primary" onAction="#validerTransaction" />
                    </HBox>
                </VBox>
                
                <!-- Panneau d'information -->
                <VBox styleClass="card" prefWidth="300" spacing="15">
                    <Label text="Information Blockchain" styleClass="card-title" />
                    <Label text="Toute transaction validee est irreversible et sera signee cryptographiquement avant d'être ajoutee au registre Hyperledger Fabric." wrapText="true" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;" />
                    <Separator />
                    <Label text="Stock Disponible" styleClass="form-label" />
                    <Label fx:id="labelStockDispo" text="Selectionnez un produit" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
